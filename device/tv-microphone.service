[Unit]
Description=Xiaomi TV microphone button to YouTube
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/tv-cloud-build/device/mic-bridge.py
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
